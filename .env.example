# Copy to .env and adjust. Never commit real keys.
TRUSTDESK_TOKEN=demo-token
TRUSTDESK_DB=trustdesk.db
# mock | gemini | groq
MODEL_PROVIDER=mock
# Only needed when MODEL_PROVIDER is gemini or groq
MODEL_API_KEY=
# Optional. Overrides the provider's default model name
MODEL_NAME=
# Prefix for all table names
TRUSTDESK_TABLE_PREFIX=td_
